# Copy this file to .env and fill in what you use.

# ── LLM providers (set at least one key, or use Ollama) ──
GEMINI_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# gemini | openai | ollama  (falls back to another provider if this one has no key)
DEFAULT_LLM_PROVIDER=gemini

# Model names — change these when a provider retires a model
GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_MODEL=gpt-4o-mini
OLLAMA_MODEL=llama3.2

# ── Server ──
# 127.0.0.1 = only this computer can open Jarvis (recommended; there is no login)
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=false

# Extra browser origins allowed to call the API, as a JSON list, e.g.
# ALLOWED_ORIGINS=["http://localhost:5173"]

# ── Behaviour ──
CURRENCY_SYMBOL=₹
MAX_HISTORY_MESSAGES=20
REMINDER_CHECK_SECONDS=30

# Optional: custom database location (defaults to jarvis.db in the project folder)
# DATABASE_URL=sqlite+aiosqlite:///C:/path/to/jarvis.db
